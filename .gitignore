#IDEs
.vscode

# Dependencies
/node_modules

# Production
/build

# Cloned spoke repositories (populated at build time)
/spokes

# API-reference HTML copied in by `tools/integrate_api_docs.py` when
# INCLUDE_API_DOCS=1 (see scripts/run-api-docs-prebuild.sh). Large
# (multi-GB at full scale) and always regenerated from a Sphinx build
# output — never hand-edited, never committed.
/static/api

# Versioning symlinks created by clone-spokes.sh from each spoke's
# docs-versions/. Default plugin uses unprefixed names; non-default plugins
# use `<id>_` (with `id` from spokes.yml) — keep both forms ignored.
/versions.json
/versioned_docs
/versioned_sidebars
/*_versions.json
/*_versioned_docs
/*_versioned_sidebars

# Generated files
.docusaurus
.cache-loader

# Misc
.DS_Store
.idea
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
